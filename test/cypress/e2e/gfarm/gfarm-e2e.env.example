# WHEEL Gfarm E2E test environment variables
# Copy this file to gfarm-e2e.env and fill in your values.
# gfarm-e2e.env is gitignored and must NOT be committed.
#
# Also used by hpciss.cy.js in this same directory - HPCI-SS is built on
# the same Gfarm/CSGW/JWT infrastructure, so it shares these variables
# (its own test files are written under a WHEEL_E2E_HPCISS_TEST
# subdirectory of WHEEL_GFARM_STORAGE_ROOT to avoid colliding with
# gfarmWorkflow.cy.js's own test files).
#
# Cypress reads process env vars prefixed with CYPRESS_ and exposes them
# via Cypress.env() with the prefix stripped. E.g. CYPRESS_WHEEL_GFARM_CSGW_HOSTNAME
# becomes Cypress.env("WHEEL_GFARM_CSGW_HOSTNAME") inside tests.

# ---------------------------------------------------------------
# CSGW (Gfarm proxy host) settings
# ---------------------------------------------------------------
# Hostname/IP of the CSGW (Gfarm front-end SSH server)
CYPRESS_WHEEL_GFARM_CSGW_HOSTNAME=csgw.example.com

# SSH login user on the CSGW
CYPRESS_WHEEL_GFARM_CSGW_USERNAME=your_csgw_user

# SSH port on the CSGW (default: 22)
CYPRESS_WHEEL_GFARM_CSGW_PORT=22

# ---------------------------------------------------------------
# JWT / Gfarm authentication settings
# ---------------------------------------------------------------
# Username on the JWT authentication server
CYPRESS_WHEEL_GFARM_JWT_USERNAME=your_jwt_user

# Full URL of the JWT authentication server
# Leave blank to use the WHEEL server default (NII's server)
CYPRESS_WHEEL_GFARM_JWT_URL=

# Root directory on Gfarm where test files will be written.
# Example: /home/your_group/your_jwt_user/WHEEL_E2E_GFARM_TEST
CYPRESS_WHEEL_GFARM_STORAGE_ROOT=/home/your_group/your_jwt_user/WHEEL_E2E_GFARM_TEST

# ---------------------------------------------------------------
# Remote job host settings
# ---------------------------------------------------------------
# Label used inside WHEEL for this remote host entry
CYPRESS_WHEEL_GFARM_REMOTE_LABEL=gfarm-e2e-remote

# Hostname/IP of the remote HPC login node
CYPRESS_WHEEL_GFARM_REMOTE_HOSTNAME=login.hpc.example.com

# SSH login user on the remote HPC host
CYPRESS_WHEEL_GFARM_REMOTE_USERNAME=your_hpc_user

# SSH port on the remote HPC host (default: 22)
CYPRESS_WHEEL_GFARM_REMOTE_PORT=22

# Working directory on the remote host
# Leave blank to use the WHEEL server default
CYPRESS_WHEEL_GFARM_REMOTE_WORKDIR=
