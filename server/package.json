{
  "name": "WHEEL",
  "version": "2.0.1",
  "description": "Scientific Workflow system",
  "main": "app/index.js",
  "author": {
    "name": "Kenji Ono"
  },
  "contributors": [
    "Tomohiro Kawanabe",
    "Kazuya Tsuruta",
    "Naoyuki Sogo",
    "Yuki Tanaka"
  ],
  "license": "BSD-2-Clause",
  "type": "module",
  "engines": {
    "node": ">=12"
  },
  "scripts": {
    "start": "node app/index",
    "mocha": "../node_modules/.bin/mocha",
    "UT:setup": "test/setup.sh",
    "UT:setupDocker": "test/setup.sh test_setting_docker.txt",
    "UT:teardown": "test/teardown.sh",
    "UT:local": "dotenv -e test/.env -- npm run mocha -- --recursive test/app --unhandled-rejections=strict --ignore '**/gfarmOperator.js'",
    "UT:local-gfarm": "dotenv -e test/.env -- npm run mocha -- --unhandled-rejections=strict '**/gfarmOperator.js'",
    "UT:docker": "docker compose --env-file test/.env -f test/compose.yml run --build wheel_release_test",
    "test": "run-s UT:setup UT:local UT:teardown",
    "testDocker": "run-s UT:setupDocker UT:docker UT:teardown",
    "coverage": "nyc --reporter=html --reporter=text npm run UT:local"
  },
  "files": [
    "app",
    "package.json"
  ],
  "dependencies": {
    "@eyalsh/docopt": "^1.0.7",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axios": "^1.13.1",
    "body-parser": "^2.2.0",
    "c12": "^3.3.4",
    "connect-ensure-login": "^0.1.1",
    "connect-sqlite3": "^0.9.15",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "debug": "^4.3.7",
    "express": "^5.1.0",
    "express-async-handler": "^1.2.0",
    "express-ipfilter": "^1.3.2",
    "express-session": "^1.18.1",
    "file-type": "^21.0.0",
    "fs-extra": "^11.1.0",
    "glob": "^11.0.3",
    "is-path-inside": "^4.0.0",
    "is-svg": "^6.1.0",
    "just-diff": "^6.0.2",
    "just-diff-apply": "^5.5.0",
    "klaw": "^4.1.0",
    "log4js": "^6.9.1",
    "lowdb": "^7.0.1",
    "minimatch": "^10.1.1",
    "nunjucks": "^3.2.4",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "perfect-debounce": "^2.0.0",
    "promise-retry": "^2.0.1",
    "rwatchd": "^1.0.0",
    "simple-batch-system": "^2.1.0",
    "socket.io": "^4.8.1",
    "socketio-file-upload": "^0.7.3",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "ssh-client-wrapper": "^2.12.4",
    "stat-mode": "^1.0.0",
    "tar": "^7.5.2",
    "uuid": "^13.0.0",
    "zip-a-folder": "^3.1.9"
  },
  "devDependencies": {
    "chai": "^6.2.0",
    "chai-as-promised": "^8.0.2",
    "chai-iterator": "^3.0.2",
    "deep-equal-in-any-order": "^2.0.6",
    "dotenv-cli": "^11.0.0",
    "mocha": "^11.7.4",
    "nyc": "^17.1.0",
    "sinon": "^21.0.0",
    "sinon-chai": "^4.0.1",
    "tmp": "^0.2.5",
    "tmp-promise": "^3.0.3"
  }
}
